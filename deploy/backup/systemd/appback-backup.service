# Chạy backup.sh một lần theo lịch của appback-backup.timer (B0-10 [2]).
# Múi giờ OnCalendar của timer đi cạnh là GIỜ MÁY (systemd), không phải UTC.
[Unit]
Description=Sao lưu AppBack (Postgres + kho object)
Wants=network-online.target
After=network-online.target docker.service

[Service]
Type=oneshot
User=deploy
UMask=0077
EnvironmentFile=/etc/appback/appback.env
WorkingDirectory=/opt/appback
# Script của bản đang chạy (symlink current → releases/<tag>, K-35); gọi qua bash vì bó
# phát hành giữ mode 644 của repo — exec trực tiếp sẽ hỏng "Permission denied".
ExecStart=/bin/bash /opt/appback/current/deploy/backup/backup.sh
